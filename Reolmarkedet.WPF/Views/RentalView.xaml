<UserControl x:Class="Reolmarkedet.WPF.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
             xmlns:enums="clr-namespace:Reolmarkedet.WPF.ViewModels.enums"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Lejemål"
                   FontSize="28" FontWeight="SemiBold"
                   Margin="0,0,0,24" />

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Vis lejemål:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <ComboBox Width="180"
                          Style="{StaticResource InputComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedRentalStatusFilter,
                          Mode=TwoWay}">
                    <ComboBoxItem Content="Aktive"
                                  Tag="{x:Static vm:RentalStatusFilter.Active}" />
                    <ComboBoxItem Content="Kommende"
                                  Tag="{x:Static vm:RentalStatusFilter.Upcoming}" />
                    <ComboBoxItem Content="Historiske"
                                  Tag="{x:Static vm:RentalStatusFilter.Historical}" />
                    <ComboBoxItem Content="Alle"
                                  Tag="{x:Static vm:RentalStatusFilter.All}" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="0" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding RentalRows}"
                      SelectedItem="{Binding SelectedRentalRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Style="{StaticResource ManagementDataGridStyle}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding RentalId}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"
                                        Width="50" />

                    <DataGridTextColumn Header="Reollejer"
                                        Binding="{Binding TenantName}"
                                        Width="*"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"
                                        MinWidth="140" />

                    <DataGridTextColumn Header="Reol"
                                        Binding="{Binding ShelfNumber}"
                                        Width="60"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}" />

                    <DataGridTemplateColumn Header="Status"  HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="RentalStatusPill"
                                        Width="88" Height="28"
                                        CornerRadius="14"
                                        Margin="6,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="RentalStatusText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:RentalStatus.Active}">
                                        <Setter TargetName="RentalStatusText"
                                                Property="Text" Value="Aktiv" />
                                        <Setter TargetName="RentalStatusPill"
                                                Property="Background" Value="#2F4635" />
                                        <Setter TargetName="RentalStatusText"
                                                Property="Foreground" Value="#B7DDBE" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:RentalStatus.Historical}">
                                        <Setter TargetName="RentalStatusText"
                                                Property="Text" Value="Afsluttet" />
                                        <Setter TargetName="RentalStatusPill"
                                                Property="Background" Value="#3A3A3A" />
                                        <Setter TargetName="RentalStatusText"
                                                Property="Foreground" Value="#CCCCCC" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="{x:Static enums:RentalStatus.Upcoming}">
                                        <Setter TargetName="RentalStatusText"
                                                Property="Text" Value="Kommende" />
                                        <Setter TargetName="RentalStatusPill"
                                                Property="Background" Value="#49422E" />
                                        <Setter TargetName="RentalStatusText"
                                                Property="Foreground" Value="#E6CF8E" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Startdato"
                                        Binding="{Binding StartDate,
                                        StringFormat=dd-MM-yyyy}"
                                        Width="110"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}" />

                    <DataGridTextColumn Header="Slutdato"
                                        Binding="{Binding EndDate,
                                        StringFormat=dd-MM-yyyy,
                                        TargetNullValue='—'}"
                                        Width="110"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}" />

                    <DataGridTextColumn Header="Månedlig leje"
                                        Binding="{Binding MonthlyRent,
                                        StringFormat='{}{0:N2} kr.'}"
                                        Width="120"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Background="#292929"
                    BorderBrush="#595959"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="18"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasSelectedRental,
                    Converter={StaticResource BoolToVisibility}}">

                <StackPanel>
                    <TextBlock Text="Valgt lejemål"
                               FontSize="20"
                               Margin="0,0,0,4" />

                    <TextBlock Margin="0,0,0,16"
                               TextWrapping="Wrap">
                        <Run Text="{Binding SelectedRentalRow.ShelfNumber,
                             Mode=OneWay, StringFormat='Reol {0}'}" />
                        <Run Text=" - " />
                        <Run Text="{Binding SelectedRentalRow.TenantName,
                             Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="Lejemålet er afsluttet og kan ikke ændres."
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsSelectedRentalHistorical,
                               Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedRentalHistorical}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>


                        <TextBlock Text="Sidste lejedag"
                                   Margin="0,0,0,4" />

                        <WrapPanel>
                            <DatePicker SelectedDate="{Binding TerminationEndDate, Mode=TwoWay}"
                                        Width="180"
                                        Margin="0,0,12,8"
                                        DisplayDateStart="{Binding MinimumStartDate, Mode=OneWay}"
                                        Style="{StaticResource InputDatePickerStyle}" />

                            <Button Content="Opsig lejemål"
                                    Command="{Binding TerminateRentalCommand}"
                                    Visibility="{Binding ShowTerminateButton,
                                    Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,12,8"
                                    Style="{StaticResource WarningButtonStyle}" />

                            <Button Content="Gem ændret slutdato"
                                    Command="{Binding ChangeTerminationEndDateCommand}"
                                    Visibility="{Binding ShowChangeEndDateButton,
                                    Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,12,8"
                                    Style="{StaticResource PrimaryButtonStyle}" />

                            <Button Content="Fortryd opsigelse"
                                    Command="{Binding UndoTerminationCommand}"
                                    Visibility="{Binding ShowUndoTerminationButton,
                                    Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,12,8"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding TerminationMessage}"
                           Foreground="#F28B82"
                           Style="{StaticResource MessageTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <TextBlock Text="{Binding TerminationConfirmationMessage}"
                           Foreground="#B7DDBE"
                           Style="{StaticResource MessageTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <Border Background="#292929"
                    BorderBrush="#595959"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="18"
                    VerticalAlignment="Top">
                <StackPanel>

                    <TextBlock Text="Opret lejemål"
                               FontSize="20"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Reollejer" />
                    <ComboBox ItemsSource="{Binding ActiveTenants}"
                              Style="{StaticResource InputComboBoxStyle}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                              Margin="0,4,0,12" />

                    <TextBlock Text="Startdato" />
                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                Margin="0,4,0,12"
                                DisplayDateStart="{Binding MinimumStartDate, Mode=OneWay}"
                                Style="{StaticResource InputDatePickerStyle}" />

                    <TextBlock Text="Slutdato (valgfri)" />
                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                Margin="0,4,0,12"
                                DisplayDateStart="{Binding StartDate, Mode=OneWay}"
                                Style="{StaticResource InputDatePickerStyle}" />

                    <TextBlock Text="Ledig reol i den valgte periode" />
                    <ComboBox ItemsSource="{Binding AvailableShelves}"
                              Style="{StaticResource InputComboBoxStyle}"
                              DisplayMemberPath="ShelfNumber"
                              SelectedItem="{Binding SelectedShelf, Mode=TwoWay}"
                              Margin="0,4,0,12" />

                    <Button Content="Tilføj reol"
                            Command="{Binding AddShelfToSelectionCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,0,12" />

                    <TextBlock Text="Valgte reoler:" Margin="0,0,0,4" />

                    <TextBlock Text="Ingen reoler valgt. Vælg en ledig reol og klik Tilføj reol."
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedShelves.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding SelectedShelves}"
                                  Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border  Background="#333333"
                                        BorderBrush="#404040"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8"
                                        Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Fjern"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Command="{Binding DataContext.RemoveShelfFromSelectionCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <TextBlock Text="{Binding ShelfNumber, StringFormat='Reol {0}'}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Aftalt månedlig leje pr. reol (kr.)"/>

                    <TextBox Text="{Binding MonthlyRent,
                             Mode=TwoWay,
                             UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsCustomPrice}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,4,0,12" />

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Angiv specialpris"
                                Command="{Binding EnableCustomPriceCommand}"
                                Margin="0,0,8,8"
                                Style="{StaticResource ActionButtonStyle}" />

                        <Button Content="Brug standardpris"
                                Command="{Binding UseStandardPriceCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,8"/>
                    </WrapPanel>

                    <Border BorderBrush="#404040"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Samlet månedlig leje for valgte reoler"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding TotalMonthlyRent,
                                       StringFormat='{}{0:N2} kr.',
                                       TargetNullValue='Ugyldig pris'}"
                                       Margin="0,4,0,0"
                                       FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Opret lejemål"
                            Command="{Binding CreateRentalsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,0,12" />

                    <TextBlock Text="{Binding RentalMessage}"
                               Foreground="#F28B82"
                               Style="{StaticResource MessageTextStyle}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding RentalConfirmationMessage}"
                               Foreground="#B7DDBE"
                               Style="{StaticResource MessageTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
