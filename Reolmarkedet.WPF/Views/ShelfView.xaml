<UserControl x:Class="Reolmarkedet.WPF.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             xmlns:models="clr-namespace:Reolmarkedet.Core.Models;assembly=Reolmarkedet.Core"
             xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="1" Grid.Column="0"
                   Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filtrer reoler efter status:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <ComboBox Width="180"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}">

                    <ComboBox.Style>
                        <Style TargetType="ComboBox"
                               BasedOn="{StaticResource InputComboBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowInactiveShelves}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>

                    <ComboBoxItem Content="Alle"
                                  Tag="{x:Static vm:ShelfStatusFilter.All}" />
                    <ComboBoxItem Content="Ledige"
                                  Tag="{x:Static vm:ShelfStatusFilter.Available}" />
                    <ComboBoxItem Content="Udlejede"
                                  Tag="{x:Static vm:ShelfStatusFilter.Rented}" />
                    <ComboBoxItem Content="Opsagte"
                                  Tag="{x:Static vm:ShelfStatusFilter.TerminationPending}" />
                </ComboBox>

            </StackPanel>

            <CheckBox Content="Kun deaktiverede"
                      Style="{StaticResource FilterCheckBoxStyle}"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowInactiveShelves,
                      Mode=TwoWay}"
                      Margin="16,0,0,0" />
        </WrapPanel>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Reoler"
                   FontSize="28" FontWeight="SemiBold"
                   Margin="0,0,0,24" />


        <!-- Shelf List-->
        <DataGrid Grid.Row="2" Grid.Column="0"
                  ItemsSource="{Binding VisibleShelves}"
                  SelectedItem="{Binding SelectedShelfRow, Mode=TwoWay}"
                  Style="{StaticResource ManagementDataGridStyle}"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Reolnummer"
                                    Binding="{Binding ShelfNumber}"
                                    Width="95"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Nuværende lejer"
                                    Binding="{Binding CurrentTenantName}"
                                    Width="*" MinWidth="120"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTemplateColumn Header="Reoltype"
                                        Width="1.3*" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.ShelfTypes,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                DisplayMemberPath="Name"
                                SelectedItem="{Binding ShelfType, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputComboBoxStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status"  HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                        Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="StatusPill"
                                    Width="76" Height="28"
                                    CornerRadius="14"
                                    Margin="6,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="StatusText"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Ukendt" />

                                            <Style.Triggers>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShelfStatus}"
                                             Value="{x:Static models:ShelfStatus.Available}">
                                    <Setter TargetName="StatusText" Property="Text" Value="Ledig" />
                                    <Setter TargetName="StatusPill" Property="Background" Value="#2F4635" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B7DDBE" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ShelfStatus}"
                                             Value="{x:Static models:ShelfStatus.Rented}">
                                    <Setter TargetName="StatusText" Property="Text" Value="Udlejet" />
                                    <Setter TargetName="StatusPill" Property="Background" Value="#4B3030" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#F2B1B1" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ShelfStatus}"
                                             Value="{x:Static models:ShelfStatus.TerminationPending}">
                                    <Setter TargetName="StatusText" Property="Text" Value="Opsagt" />
                                    <Setter TargetName="StatusPill" Property="Background" Value="#49422E" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#E6CF8E" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Sidste lejedag"
                                    Binding="{Binding TerminationEndDate,
                                    StringFormat=dd-MM-yyyy,
                                    TargetNullValue='-'}"
                                    Width="115"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Manage shelves and shelf types -->
        <ScrollViewer Grid.Row="2" Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <Border Background="#292929"
                    BorderBrush="#595959"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="18"
                    VerticalAlignment="Top">

                <StackPanel>
                    <Expander Header="Tilføj reol"
                              Foreground="#EEEEEE"
                              IsExpanded="False"
                              Margin="0,0,0,12">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Reolnummer" Margin="0,0,0,4" />

                            <TextBox VerticalContentAlignment="Center"
                                     Text="{Binding NewShelfNumber,
                                     Mode=TwoWay,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"/>

                            <TextBlock Text="Reoltype" Margin="0,8,0,4" />

                            <StackPanel>
                                <ComboBox ItemsSource="{Binding ShelfTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding NewShelfType,
                                          Mode=TwoWay}"
                                          Style="{StaticResource InputComboBoxStyle}"/>

                                <Button Content="Tilføj reol"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddShelfCommand}"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Administrer reoltyper"
                              Foreground="#EEEEEE"
                              IsExpanded="False">

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Ny reoltype" Margin="0,0,0,4" />

                            <StackPanel>
                                <TextBox VerticalContentAlignment="Center"
                                         Text="{Binding NewShelfTypeName,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <Button Content="Tilføj reoltype"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddShelfTypeCommand}"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                            <TextBlock Text="Slet reoltype"
                                       Margin="0,8,0,4" />

                            <StackPanel>
                                <ComboBox ItemsSource="{Binding ShelfTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding ShelfTypeToDelete,
                                          Mode=TwoWay}"
                                          Style="{StaticResource InputComboBoxStyle}"/>

                                <Button Content="Slet reoltype"
                                        Style="{StaticResource WarningButtonStyle}"
                                        Command="{Binding DeleteShelfTypeCommand}"
                                        Margin="0,8,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding ShelfTypeMessage}"
                                       Style="{StaticResource MessageTextStyle}"
                                       Foreground="#F28B82"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <TextBlock Text="{Binding ShelfTypeConfirmationMessage}"
                                       Style="{StaticResource MessageTextStyle}"
                                       Foreground="#B7DDBE"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>

                    <WrapPanel Orientation="Horizontal"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasSelectedShelf,
                               Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Slet valgt reol"
                                Style="{StaticResource WarningButtonStyle}"
                                Command="{Binding DeleteShelfCommand}"
                                Visibility="{Binding HasSelectedShelf,
                                Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,8" />

                        <Button Content="Deaktiver valgt reol"
                                Style="{StaticResource WarningButtonStyle}"
                                Command="{Binding DeactivateShelfCommand}"
                                Visibility="{Binding ShowDeactivateButton,
                                Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,8" />

                        <Button Content="Genaktiver valgt reol"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ReactivateShelfCommand}"
                                Visibility="{Binding ShowReactivateButton,
                                Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <TextBlock Text="{Binding ShelfMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#F28B82"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8" />

                    <TextBlock Text="{Binding ShelfConfirmationMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#B7DDBE"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8" />

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
