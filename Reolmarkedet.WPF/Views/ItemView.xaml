<UserControl x:Class="Reolmarkedet.WPF.Views.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="3"
                   Text="Varer"
                   FontSize="28" FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="Søg efter usolgte varer (beskrivelse eller stregkode)"/>
            <TextBox Text="{Binding SearchText,
                     UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItemRow, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" Style="{StaticResource ManagementDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Varenr." Binding="{Binding ItemId}" Width="65" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}" Width="2*" MinWidth="160" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Pris" Binding="{Binding Price, StringFormat='{}{0:N2} kr.', ConverterCulture=da-DK}" Width="110" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Reol"
                                    Binding="{Binding ShelfNumber}"
                                    Width="60"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Reollejer"
                                    Binding="{Binding TenantName}"
                                    Width="*"
                                    MinWidth="120"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Stregkode"
                                    Binding="{Binding Barcode}"
                                    Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource ManagementCellTextStyle}">
                            <Setter Property="ToolTip" Value="{Binding Barcode}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Border Background="#292929" BorderBrush="#595959" BorderThickness="1" Padding="18" VerticalAlignment="Top"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="20" Margin="0,0,0,16"/>
                    <TextBlock Text="Lejemål"/>

                    <ComboBox SelectedItem="{Binding SelectedRental}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsNew}"
                              Margin="0,4,0,12">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox"
                                   BasedOn="{StaticResource InputComboBoxStyle}">
                                <Setter Property="ItemsSource"
                                        Value="{Binding EligibleRentalOptions}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding RentalOptions}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Text="Beskrivelse"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Pris i kr."/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Varenummer og stregkode tildeles automatisk ved oprettelse." TextWrapping="Wrap" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="Opret vare" Command="{Binding SaveCommand}"
                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>

                        <Button Content="Opdater vare" Command="{Binding SaveCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>

                        <Button Content="Annuller" Command="{Binding NewCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>

                    </WrapPanel>

                    <Border BorderBrush="#595959" BorderThickness="0,1,0,0"
                            Margin="0,16,0,0" Padding="0,12,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Slet vare"
                                Command="{Binding DeleteItemCommand}"
                                Style="{StaticResource WarningButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </Border>

                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#F28B82"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding ConfirmationMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#B7DDBE"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
