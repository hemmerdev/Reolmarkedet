<UserControl x:Class="Reolmarkedet.WPF.Views.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Varer" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Skriv, indsæt eller scan stregkode — tryk Enter for at finde varen"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Find vare" Command="{Binding FindCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding LookupBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Opdater liste" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
                <TextBlock Text="Usolgte varer" FontSize="20" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding UnsoldItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" Style="{StaticResource ManagementDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Varenr." Binding="{Binding ItemId}" Width="65" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Pris" Binding="{Binding Price, StringFormat=N2, ConverterCulture=da-DK}" Width="85" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Lejemål" Binding="{Binding RentalId}" Width="70" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Stregkode" Binding="{Binding Barcode}" Width="160" ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Background="#292929" BorderBrush="#595959" BorderThickness="1" Padding="18" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="20" Margin="0,0,0,16"/>
                    <TextBlock Text="Lejemål"/>
                    <ComboBox ItemsSource="{Binding RentalOptions}" SelectedItem="{Binding SelectedRental}" DisplayMemberPath="Label"
                              IsEnabled="{Binding IsNew}" Style="{StaticResource InputComboBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Beskrivelse"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Pris i kr. (fx 125,50)"/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Stregkode (tom = genereres automatisk)" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditing}" MaxLength="50"
                             Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,12"/>
                    <TextBlock Text="Varenummer tildeles ved oprettelse. Stregkode og lejemål bevares ved redigering." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Gem vare" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Ny / annuller" Command="{Binding NewCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F2CE82" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
