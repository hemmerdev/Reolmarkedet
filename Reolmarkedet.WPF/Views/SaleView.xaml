<UserControl x:Class="Reolmarkedet.WPF.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="Salg"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Registrerede salg"
                   FontSize="20"
                   VerticalAlignment="Top"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Text="Registrer nyt salg"
                   FontSize="20"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="2"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Border Background="#292929"
                    BorderBrush="#595959"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="18"
                    VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Vælg reol og reollejer"/>

                        <ComboBox ItemsSource="{Binding RentalOptions}"
                                  SelectedItem="{Binding SelectedRentalOption, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,4,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding ShelfNumber, Mode=OneWay, StringFormat='Reol {0}'}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding TenantName, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Vælg usolgt vare"/>

                        <ComboBox ItemsSource="{Binding ItemOptions}"
                                  SelectedItem="{Binding SelectedItemOption, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,4,0,20">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Description, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat='{}{0:0.00} kr.'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Expander Header="Find via varenummer eller stregkode"
                                  Foreground="#EEEEEE"
                                  IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding FindItemCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="Find vare"
                                            Command="{Binding FindItemCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Border Margin="0,24,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="Salgsoplysninger"
                                       FontSize="20"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Salgspris (kr.)"/>
                            <TextBox Text="{Binding SalePriceText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,4,0,12"/>

                            <TextBlock Text="Bemærkninger (valgfrit)"/>
                            <TextBox Text="{Binding Notes,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,4,0,16"/>

                            <Button Content="Registrer salg"
                                    Command="{Binding RegisterSaleCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding SaleMessage}"
                               Foreground="#F28B82"
                               TextWrapping="Wrap"
                               Style="{StaticResource MessageTextStyle}"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding SaleConfirmationMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#B7DDBE"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <DataGrid Grid.Row="2"
                  Grid.Column="0"
                  ItemsSource="{Binding Sales}"
                  Style="{StaticResource ManagementDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dato"
                                    Width="90"
                                    Binding="{Binding SaleDate, StringFormat=dd-MM-yyyy}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Vare"
                                    Width="*"
                                    Binding="{Binding ItemDescription}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Reol"
                                    Width="50"
                                    Binding="{Binding ShelfNumber}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Reollejer"
                                    Width="*"
                                    Binding="{Binding TenantName}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Salgspris"
                                    Width="100"
                                    Binding="{Binding SalePrice, StringFormat='{}{0:0.00} kr.'}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Bemærkninger"
                                    Width="*"
                                    Binding="{Binding Notes}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
