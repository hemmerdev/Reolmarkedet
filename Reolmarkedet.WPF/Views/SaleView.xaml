<UserControl x:Class="Reolmarkedet.WPF.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="Salg"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,0,12">
            <TextBlock Text="Registrerede salg"
                       FontSize="20"
                       Margin="0,0,0,12"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Søg efter vare, lejer eller reol"
                           TextWrapping="Wrap"/>

                <TextBox Grid.Row="1"
                         Text="{Binding SaleSearchText,
                         UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,4,0,0"/>

                <TextBlock Grid.Column="2" Text="Fra dato (valgfri)"/>

                <DatePicker Grid.Row="1"
                            Grid.Column="2"
                            SelectedDate="{Binding SaleFromDate, Mode=TwoWay}"
                            DisplayDateEnd="{Binding SaleToDate, Mode=OneWay}"
                            Style="{StaticResource InputDatePickerStyle}"
                            Margin="0,4,0,0"/>

                <TextBlock Grid.Column="4" Text="Til dato (valgfri)"/>

                <DatePicker Grid.Row="1"
                            Grid.Column="4"
                            SelectedDate="{Binding SaleToDate, Mode=TwoWay}"
                            DisplayDateStart="{Binding SaleFromDate, Mode=OneWay}"
                            Style="{StaticResource InputDatePickerStyle}"
                            Margin="0,4,0,0"/>

                <Button Grid.Row="1"
                        Grid.Column="6"
                        Content="Nulstil filtre"
                        Command="{Binding ClearSaleFiltersCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,4,0,0"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">


            <Border Background="#292929"
                    BorderBrush="#595959"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="18"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Registrer køb"
                               FontSize="20"
                               Margin="0,0,0,16"/>
                    <StackPanel>
                        <Expander Header="Find via varenummer eller stregkode"
                                  Foreground="#EEEEEE"
                                  IsExpanded="False"
                                  Margin="0,0,0,16">
                            <StackPanel Margin="0,8,0,0">

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding FindItemCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="Find vare"
                                            Command="{Binding FindItemCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Vælg reol og reollejer"/>

                        <ComboBox ItemsSource="{Binding RentalOptions}"
                                  SelectedItem="{Binding SelectedRentalOption, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,4,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding ShelfNumber, Mode=OneWay, StringFormat='Reol {0}'}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding TenantName, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Vælg usolgt vare"/>

                        <ComboBox ItemsSource="{Binding ItemOptions}"
                                  SelectedItem="{Binding SelectedItemOption, Mode=TwoWay}"
                                  Margin="0,4,0,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource InputComboBoxStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Description, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat='{}{0:0.00} kr.', ConverterCulture='da-DK'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Salgspris (kr.)"/>
                            <TextBox Text="{Binding SalePriceText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,4,0,12"/>

                            <TextBlock Text="Bemærkninger (valgfrit)"/>
                            <TextBox Text="{Binding Notes,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,4,0,16"/>

                            <Button Content="Tilføj til kurv"
                                    Command="{Binding AddToBasketCommand}"
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,24,0,0">

                        <TextBlock Text="Varer i kurven:"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Ingen varer i kurven. Vælg en vare og klik Tilføj til kurv."
                                   Foreground="#AAAAAA"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BasketItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding BasketItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333333"
                                            BorderBrush="#404040"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8"
                                            Margin="0,0,0,6">

                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Fjern"
                                                    Command="{Binding DataContext.RemoveFromBasketCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="12,0,0,0"/>

                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SalePrice,
                                                       ConverterCulture=da-DK,
                                                       StringFormat='{}{0:N2} kr.'}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="#404040"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0"
                                Margin="0,12,0,16">
                            <StackPanel>
                                <TextBlock Text="Samlet pris"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding BasketTotal,
                                           ConverterCulture=da-DK,
                                           StringFormat='{}{0:N2} kr.'}"
                                           Margin="0,4,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Registrer køb"
                                Command="{Binding RegisterSaleCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SaleMessage}"
                               Foreground="#F28B82"
                               TextWrapping="Wrap"
                               Style="{StaticResource MessageTextStyle}"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding SaleConfirmationMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#B7DDBE"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <DataGrid Grid.Row="2"
                  Grid.Column="0"
                  ItemsSource="{Binding VisibleSales}"
                  Style="{StaticResource ManagementDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dato"
                                    Width="90"
                                    Binding="{Binding SaleDate, StringFormat=dd-MM-yyyy}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Vare"
                                    Width="*"
                                    Binding="{Binding ItemDescription}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Reol"
                                    Width="50"
                                    Binding="{Binding ShelfNumber}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Reollejer"
                                    Width="*"
                                    Binding="{Binding TenantName}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Salgspris"
                                    Width="100"
                                    Binding="{Binding SalePrice, StringFormat='{}{0:0.00} kr.', ConverterCulture='da-DK'}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTextColumn Header="Bemærkninger"
                                    Width="*"
                                    Binding="{Binding Notes}"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="16,56,16,0"
                   VerticalAlignment="Top"
                   Foreground="#AAAAAA"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Text"
                            Value="Ingen salg matcher de valgte filtre."/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisibleSales.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Sales.Count}" Value="0">
                            <Setter Property="Text"
                                    Value="Der er endnu ikke registreret nogen salg."/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
