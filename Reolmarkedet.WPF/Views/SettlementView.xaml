<UserControl x:Class="Reolmarkedet.WPF.Views.SettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarkedet.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Månedsopgørelse"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="0,0,0,24" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">

            <TextBlock Text="Opgørelser"
                       FontSize="20"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal">
                <StackPanel Width="120" Margin="0,0,12,0">


                    <TextBlock Text="Måned" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding MonthOptions}"
                              SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="År" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding YearOptions}"
                              SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}"/>
                </StackPanel>

                <Button x:Name="CalculateButton"
                        Content="Beregn opgørelser"
                        Command="{Binding CalculateSettlementsCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom"/>
            </StackPanel>

            <TextBlock Text="Opgørelser beregnes ud fra aktuelle data. Rettelser og returneringer kan ændre tidligere måneder. Betaling registreres ikke her."
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
            <TextBlock Text="Månedsopgørelser kan kun beregnes for afsluttede måneder."
                       Foreground="#AAAAAA"
                       Margin="0,8,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=CalculateButton, Path=IsEnabled}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding MonthlySettlements}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectedItem="{Binding SelectedSettlement, Mode=TwoWay}"
                  Style="{StaticResource ManagementDataGridStyle}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reollejer" Binding="{Binding Tenant.Name}" Width="Auto"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Salg denne måned" Binding="{Binding TotalSales, StringFormat=N2, ConverterCulture=da-DK}" Width="*"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Kommission (10%)" Binding="{Binding Commission, StringFormat=N2, ConverterCulture=da-DK}" Width="*"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Næste måneds leje" Binding="{Binding Rent, StringFormat=N2, ConverterCulture=da-DK}" Width="*"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=N2, ConverterCulture=da-DK}" Width="*"
                                    ElementStyle="{StaticResource ManagementCellTextStyle}"/>

                <DataGridTemplateColumn Header="Status"
                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                        Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="StatusPill"
                                    Background="#3A3A3A"
                                    Height="28"
                                    Width="130"
                                    CornerRadius="14"
                                    Padding="12,0"
                                    Margin="6,4"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           Text="{Binding Status}"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Til udbetaling">
                                    <Setter TargetName="StatusPill" Property="Background" Value="#2F4635"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B7DDBE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skylder">
                                    <Setter TargetName="StatusPill" Property="Background" Value="#4B3030"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#F2B1B1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Ingen opgørelser at vise. Tryk beregn opgørelser."
                   Margin="16,56,16,0"
                   VerticalAlignment="Top"
                   Foreground="#AAAAAA"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MonthlySettlements.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3"
                Background="#292929"
                BorderBrush="#595959"
                BorderThickness="1"
                CornerRadius="3"
                Padding="18"
                Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSettlement}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,0,0,16">
                    <TextBlock Text="Detaljer for "
                               FontSize="20"/>
                    <TextBlock Text="{Binding SelectedSettlement.Tenant.Name}"
                               FontSize="20"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Grid.ColumnSpan="3"
                             Columns="4" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Salg i valgt måned" Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding SelectedSettlement.TotalSales,
                                   StringFormat='{}{0:N2} kr.',
                                   ConverterCulture=da-DK}"
                                   FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="- Kommission (10%)" Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding SelectedSettlement.Commission,
                                   StringFormat='{}{0:N2} kr.',
                                   ConverterCulture=da-DK}"
                                   FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="- Leje næste måned" Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding SelectedSettlement.Rent,
                                   StringFormat='{}{0:N2} kr.',
                                   ConverterCulture=da-DK}"
                                   FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSettlement.Status}"
                                   Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding SelectedSettlement.Balance,
                                   StringFormat='{}{0:N2} kr.',
                                   ConverterCulture=da-DK}"
                                   FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </UniformGrid>

                <DockPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Salg i den valgte måned"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding SelectedSettlement.SaleLines}"
                              Height="220"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource ManagementDataGridStyle}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dato"
                                                Binding="{Binding Sale.SaleDate, StringFormat=dd-MM-yyyy}"
                                                Width="95"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Vare"
                                                Binding="{Binding Item.Description}"
                                                Width="*"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Reol"
                                                Binding="{Binding Rental.Shelf.ShelfNumber}"
                                                Width="55"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Salg"
                                                Binding="{Binding Sale.SalePrice, StringFormat=N2, ConverterCulture=da-DK}"
                                                Width="90"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Bemærkninger"
                                                Binding="{Binding Sale.Notes}"
                                                Width="160"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Kommission"
                                                Binding="{Binding Commission, StringFormat=N2, ConverterCulture=da-DK}"
                                                Width="105"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Leje for næste måned"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding SelectedSettlement.RentalLines}"
                              Height="220"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource ManagementDataGridStyle}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reol"
                                                Binding="{Binding Rental.Shelf.ShelfNumber}"
                                                Width="55"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Fra"
                                                Binding="{Binding PeriodStart, StringFormat=dd-MM-yyyy}"
                                                Width="95"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Til"
                                                Binding="{Binding PeriodEnd, StringFormat=dd-MM-yyyy}"
                                                Width="95"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Beløb"
                                                Binding="{Binding Amount, StringFormat=N2, ConverterCulture=da-DK}"
                                                Width="*"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
