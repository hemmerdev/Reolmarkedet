<Window x:Class="Reolmarkedet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reolmarkedet.WPF"
        xmlns:views="clr-namespace:Reolmarkedet.WPF.Views"
        xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Reolmarkedet" Height="950" Width="1300"
        FontFamily="Segoe UI" FontSize="14"
        Background="#202020" Foreground="#EEEEEE"
        MinHeight="650" MinWidth="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TenantViewModel}">
            <views:TenantView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShelfViewModel}">
            <views:ShelfView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RentalViewModel}">
            <views:RentalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleViewModel}">
            <views:SaleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettlementViewModel}">
            <views:SettlementView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#292929"
                BorderBrush="#595959"
                BorderThickness="0,0,1,0">

            <Grid Margin="12,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Button Content="Startside"
                            Command="{Binding ShowDashboardCommand}" >
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}"
                                                 Value="{x:Static vm:NavigationPage.Dashboard}">
                                        <Setter Property="Background" Value="#505050" />
                                        <Setter Property="BorderBrush" Value="#999999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Reollejere"
                            Command="{Binding ShowTenantsCommand}" >
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}"
                                                 Value="{x:Static vm:NavigationPage.Tenants}">
                                        <Setter Property="Background" Value="#505050" />
                                        <Setter Property="BorderBrush" Value="#999999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Reoler"
                            Command="{Binding ShowShelfManagementCommand}" >
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}"
                                                 Value="{x:Static vm:NavigationPage.Shelves}">
                                        <Setter Property="Background" Value="#505050" />
                                        <Setter Property="BorderBrush" Value="#999999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Lejemål"
                            Command="{Binding ShowRentalManagementCommand}" >
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}"
                                                 Value="{x:Static vm:NavigationPage.Rentals}">
                                        <Setter Property="Background" Value="#505050" />
                                        <Setter Property="BorderBrush" Value="#999999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Varer" Command="{Binding ShowItemManagementCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}" Value="{x:Static vm:NavigationPage.Items}">
                                        <Setter Property="Background" Value="#505050"/>
                                        <Setter Property="BorderBrush" Value="#999999"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Salg" Command="{Binding ShowSaleManagementCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}" Value="{x:Static vm:NavigationPage.Sales}">
                                        <Setter Property="Background" Value="#505050"/>
                                        <Setter Property="BorderBrush" Value="#999999"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Opgørelser" Command="{Binding ShowSettlementCommand}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}" Value="{x:Static vm:NavigationPage.Settlements}">
                                        <Setter Property="Background" Value="#505050"/>
                                        <Setter Property="BorderBrush" Value="#999999"/>
                                    </DataTrigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                        <Setter Property="ToolTip"
                                                Value="Log in som administrator for at se opgørelser" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1">

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Tilstand: Medarbejder" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Text" Value="Tilstand: Administrator" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Administrator login"
                                   Margin="0,4,0,6"
                                   FontSize="12"/>

                        <PasswordBox x:Name="AdminPasswordBox"
                                     Height="30"
                                     Background="#333333"
                                     Foreground="White"
                                     BorderBrush="#595959"
                                     VerticalContentAlignment="Center"/>

                        <Button Content="Log ind"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,8,0,0"
                                Click="AdminLogin_Click"/>

                    </StackPanel>
                    <Button Content="Log ud"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="{Binding IsAdmin}"
                            Click="AdminLogout_Click"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
