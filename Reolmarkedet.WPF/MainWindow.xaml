<Window x:Class="Reolmarkedet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reolmarkedet.WPF"
        xmlns:views="clr-namespace:Reolmarkedet.WPF.Views"
        xmlns:vm="clr-namespace:Reolmarkedet.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Reolmarkedet" Height="950" Width="1300"
        FontFamily="Segoe UI" FontSize="14"
        Background="#202020" Foreground="#EEEEEE"
        MinHeight="650" MinWidth="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TenantViewModel}">
            <views:TenantView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShelfViewModel}">
            <views:ShelfView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RentalViewModel}">
            <views:RentalView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#292929"
                BorderBrush="#595959"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="12,20">

                <Button Content="Startside"
                        Command="{Binding ShowDashboardCommand}" >

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePage}"
                                             Value="{x:Static vm:NavigationPage.Dashboard}">
                                    <Setter Property="Background" Value="#505050" />
                                    <Setter Property="BorderBrush" Value="#999999" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Reollejere"
                        Command="{Binding ShowTenantsCommand}" >
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePage}"
                                             Value="{x:Static vm:NavigationPage.Tenants}">
                                    <Setter Property="Background" Value="#505050" />
                                    <Setter Property="BorderBrush" Value="#999999" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Reoler"
                        Command="{Binding ShowShelfManagementCommand}" >

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePage}"
                                             Value="{x:Static vm:NavigationPage.Shelves}">
                                    <Setter Property="Background" Value="#505050" />
                                    <Setter Property="BorderBrush" Value="#999999" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Lejemål"
                        Command="{Binding ShowRentalManagementCommand}" >

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePage}"
                                             Value="{x:Static vm:NavigationPage.Rentals}">
                                    <Setter Property="Background" Value="#505050" />
                                    <Setter Property="BorderBrush" Value="#999999" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Varer" Command="{Binding ShowItemManagementCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePage}" Value="{x:Static vm:NavigationPage.Items}">
                                    <Setter Property="Background" Value="#505050"/>
                                    <Setter Property="BorderBrush" Value="#999999"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>

</Window>
